{
  "frontends": [
    {
      "path": "frontend",
      "framework": "react",
      "dependsOn": [
        "backend"
      ],
      "why": "React application (CRA) serving as the user dashboard for scheduling and monitoring social media posts."
    }
  ],
  "backends": [
    {
      "path": "backend",
      "language": "python",
      "framework": "fastapi",
      "dataLayer": {
        "kind": "mongodb"
      },
      "why": "FastAPI server with MongoDB (Motor) integration handling authentication, social media post management, and background scheduling."
    }
  ],
  "ignore": [
    {
      "path": "memory",
      "why": "Project documentation and testing credentials."
    },
    {
      "path": "Cloud Rub Build.docx",
      "why": "Project documentation document."
    },
    {
      "path": "Pulse Social App.docx",
      "why": "Project documentation document."
    },
    {
      "path": "render.yaml",
      "why": "Deployment configuration for Render."
    },
    {
      "path": "scenarios.md",
      "why": "Test scenario descriptions."
    },
    {
      "path": "package-lock.json",
      "why": "Root-level lock file."
    }
  ]
}